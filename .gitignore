# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
/dist/
/build/

# 虚拟环境
venv/
.venv/
python/venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# 大文件 (OSS 同步)
*.db
*.sqlite
data/
python/data/*.json
python/data/*.csv
python/data/backup/
# 例外: 瘦身版 LSTM embeddings (~0.1MB) 需入库, 供服务器 git pull (全量 273MB 仍走 OSS)
!python/data/
python/data/*
!python/data/lstm_embeddings_latest.pkl

# 前端
node_modules/
frontend/node_modules/
# dist 入库: 服务器 1.8GB 编译前端会 OOM, 让构建产物走 git, 部署=git pull
# (覆盖 ~/.gitignore_global 的 dist/ 规则)
!frontend/dist/
!frontend/dist/**

# 日志
logs/
python/logs/

# 临时
*.tmp
*.bak
*.tar.gz
*.zip

# 环境
.env
.env.localmlruns/
python/.pytest_cache/
mlruns/
# 模型文件直接提交,方便服务器pull即用
!models/
!models/**
!python/models/
!python/models/**

# add_advisor OOS 缓存 (大, 只本地用, 勿提交)
python/models/add_advisor/oos_cache.pkl
# 预测CSV (每日生成, 不入库)
models/**/prediction_*.csv
# 旧模型备份
*_old.pkl
*_backup.pkl
# 一次性脚本 (不追踪)
scripts/backfill_*.py

# 第三方模型仓库 (Kronos, 本地 clone, 勿入库)
third_party/
