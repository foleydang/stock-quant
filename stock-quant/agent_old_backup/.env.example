# 飞书 Bot 配置（从飞书开放平台获取）
# 注册步骤见: https://open.feishu.cn/app → 创建企业自建应用

# 飞书应用凭证
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 事件订阅验证（在飞书后台「事件订阅」页面获取）
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=

# 飞书推送目标
# 私聊模式用 open_id，群聊模式用 chat_id
FEISHU_TARGET_OPEN_ID=
FEISHU_TARGET_CHAT_ID=

# 百炼 DashScope API（阿里云控制台获取）
# Phase 2 启用，先不配也行
DASHSCOPE_API_KEY=

# Bot 服务端口（默认 8001）
BOT_PORT=8001