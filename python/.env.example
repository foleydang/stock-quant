# Email Notification Configuration
# Copy this file to .env and fill in your values

# SMTP Server Configuration
# Gmail: smtp.gmail.com, port 465 (SSL)
# QQ Mail: smtp.qq.com, port 465
# 163 Mail: smtp.163.com, port 465
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Sender Email Credentials
# For Gmail: Use App Password (not regular password)
# For QQ/163: Use Authorization Code
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Receiver Email(s) - comma separated for multiple recipients
EMAIL_RECEIVERS=recipient1@email.com,recipient2@email.com

# Optional: Trading Parameters
INITIAL_CAPITAL=100000
POSITION_PCT=0.15
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.08